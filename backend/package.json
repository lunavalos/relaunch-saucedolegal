{
  "name": "saucedo-backend",
  "version": "1.0.0",
  "description": "Payload CMS Backend for Saucedo Legal",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation npx tsx import-json.mjs --if-empty && cross-env NODE_OPTIONS=--no-deprecation next start -p 3000"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.92.1",
    "@payloadcms/next": "^3.92.1",
    "@payloadcms/richtext-lexical": "^3.92.1",
    "cross-env": "^7.0.3",
    "dotenv": "^18.0.9",
    "graphql": "^16.8.1",
    "next": "15.2.9",
    "payload": "^3.92.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "sharp": "^0.33.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "^5.7.2"
  }
}
