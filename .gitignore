# ==========================================
# Saucedo Legal — Root .gitignore
# ==========================================

# Dependencies (Node / Next.js / Payload)
node_modules/
*/node_modules/
.pnp
.pnp.js

# Build Outputs & Next.js cache
.next/
*/.next/
out/
*/out/
dist/
*/dist/
build/
*/build/

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
# Preserve examples:
!.env.example
!*/.env.example

# SQLite Database Locks & Temporary Journals
*.db-journal
*.db-shm
*.db-wal

# Carpeta y archivo inactivos en la raíz (evita subir 300MB+ de duplicados)
/Videos/
/Images/
/media/
payload.db

# Videos pesados que superan el límite de 100MB de GitHub
frontend/public/videos/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
